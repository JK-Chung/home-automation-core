# All credentials for this project. Setup:
#   cp .env.example .env && chmod 600 .env
# then fill in the values. Never commit .env (it is gitignored).

# --- Required before install --------------------------------------------------
# ngrok auth token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- After Home Assistant is set up (for upgrade reminders) -------------------
# Long-lived access token: HA > your profile > Security > Long-lived access tokens
HA_TOKEN=
# Notify action of your phone's HA app: HA > Developer tools > Actions,
# search "notify.mobile_app_" (enter it without the "notify." prefix)
HA_NOTIFY_SERVICE=

# Optional: where the reminder script reaches HA (default http://localhost:8123)
#HA_URL=http://localhost:8123
