// Local additions (2026-11-15): cover all repos on this Pi, not just Debian main/security.
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-updates";
        "origin=Raspberry Pi Foundation,codename=${distro_codename}";
        "origin=Docker,label=Docker CE";
        "origin=. bookworm,codename=bookworm";   // ngrok agent repo
};

// Keep locally modified config files instead of skipping the package forever
// (initramfs-tools was stuck from 2026-05-17 on a conffile prompt).
Dpkg::Options {
        "--force-confdef";
        "--force-confold";
};
