# Copy to version-watch.env (chmod 600). Never commit the real file.
# NOTIFY_METHOD: ha (Home Assistant push + dashboard notification) | log (journal only)
NOTIFY_METHOD=ha
HA_URL=http://localhost:8123
# HA profile > Security > Long-lived access tokens
HA_TOKEN=PASTE_TOKEN_HERE
# see HA Developer Tools > Actions > notify.*
HA_NOTIFY_SERVICE=mobile_app_<your_device>
